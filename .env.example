# Point this at your extracted Mirror service credential JSON file.
# Example:
# MIRROR_SERVICE_CREDENTIAL_FILE=/absolute/path/to/.secrets/mirror-service-credential/service-credential.json
MIRROR_SERVICE_CREDENTIAL_FILE=/absolute/path/to/service-credential.json

# Mirror platform host root for native mirror_sdk usage.
# Do not use the local ETF proxy URL here.
MIRROR_BASE_URL=https://platform.mirrorsecurity.io

# Default model for the app when the user does not choose one.
MIRROR_DEFAULT_MODEL=claude-sonnet-4-6

# Approximate document context cap; app uses ~4 chars/token.
MAX_DOC_TOKENS=8000
