# Mirror ETF configuration
# Get your API key from https://platform.mirrorsecurity.io
MIRROR_ETF_API_KEY=your-mirror-etf-api-key-here

# Mirror ETF base URL
# Local mode (Mirror ETF node running on your machine):
#   MIRROR_ETF_BASE_URL=http://127.0.0.1:8790/v1
# SaaS mode (Mirror's hosted platform):
#   MIRROR_ETF_BASE_URL=https://platform.mirrorsecurity.io/v1
MIRROR_ETF_BASE_URL=http://127.0.0.1:8790/v1

# The model to use (must be available on your Mirror ETF node)
MIRROR_ETF_MODEL=gpt-4o

# Max tokens to send from the document as context (keep under model limit)
MAX_DOC_TOKENS=8000
